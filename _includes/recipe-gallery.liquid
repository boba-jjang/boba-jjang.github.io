{%- comment -%}
  Renders a PhotoSwipe gallery for a recipe.
  Inputs:
    - photos: array of {path, width, height}
    - r2_base: base URL prefix (defaults to site.r2_base_url)
    - title: caption fallback for alt text
{%- endcomment -%}

{%- assign r2 = include.r2_base | default: site.r2_base_url -%}

<div class="row pswp-gallery recipe-gallery mb-3">
  {%- for photo in include.photos -%}
    {%- assign url = r2 | append: photo.path -%}
    <div class="col-sm-6 col-12 p-2">
      <a href="{{ url }}"
         data-pswp-width="{{ photo.width }}"
         data-pswp-height="{{ photo.height }}"
         target="_blank"
         class="d-block rounded z-depth-1 hoverable overflow-hidden">
        <img src="{{ url }}"
             class="img-fluid w-100"
             style="aspect-ratio: 3/2; object-fit: cover; background: var(--cursor-surface-300);"
             alt="{{ include.title | escape }}{% if include.photos.size > 1 %} — photo {{ forloop.index }}{% endif %}"
             loading="lazy">
      </a>
    </div>
  {%- endfor -%}
</div>
