---
layout: page
images:
  photoswipe: true
---

<div class="recipe-page">

  <div class="recipe-page__breadcrumb">
    <a href="{{ '/albums/homecooking/' | relative_url }}">← back to homecooking</a>
  </div>

  <header class="recipe-page__header">
    <h1 class="recipe-page__title">{{ page.title }}</h1>
    <p class="recipe-page__date">{{ page.date | date: "%B %-d, %Y" }}</p>
  </header>

  {% if page.photos and page.photos.size > 0 %}
    {% include recipe-gallery.liquid photos=page.photos title=page.title %}
  {% endif %}

  <div class="recipe-page__body">
    {{ content }}
  </div>

  {% if page.sources and page.sources.size > 0 %}
    <section class="recipe-page__sources">
      <h3>Sources</h3>
      <ul>
        {% for url in page.sources %}
          <li><a href="{{ url }}" target="_blank" rel="noopener">{{ url }}</a></li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

</div>
